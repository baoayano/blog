---
// Importing necessary components and functions
import Layout from "../../layouts/Layout.astro";
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";
import { getLocalizedPosts, type LocalizedPost } from "../../utils/posts";

// Type definition for blog posts
import type { GetStaticPathsOptions } from "astro";

// Generating static paths for pagination based on the total number of blog posts
export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
    const posts = await getLocalizedPosts();

    if (posts.length === 0) {
        return [];
    }

    return paginate(posts, {
        pageSize: 5,
    });
}

const { page } = Astro.props as {
    page: { data: LocalizedPost[]; currentPage: number; total: number };
};

const pageSize = 5;
const totalPages = Math.ceil(page.total / pageSize);
const previousPage = page.currentPage > 1 ? page.currentPage - 1 : null;
const nextPage = page.currentPage < totalPages ? page.currentPage + 1 : null;

const getPageHref = (pageNumber: number) =>
    pageNumber === 1 ? "/blog" : `/blog/${pageNumber}`;
---

<Layout
    title="Blog | Ari's Blog"
    description="Explore my latest blog posts."
>
    <div class="pt-12 pb-3">
        <h1 class="text-3xl lg:text-4xl font-bold mb-6">Blog</h1>
        <p class="text-base lg:text-lg opacity-80 mb-8">
            Umm... Welcome to my blog! I'm still working on it, but feel free to
            check back later for updates and new posts.
        </p>
    </div>

    <div class="flex flex-col gap-y-6">
        {
            page.data.map((post: LocalizedPost) => (
                <a
                    href={`/blog/${post.slug}`}
                    class="blog-post block flex flex-col lg:flex-row gap-x-6 group"
                    data-title-vi={post.vi.data.title}
                    data-title-en={post.en?.data.title ?? post.vi.data.title}
                    data-description-vi={post.vi.data.description}
                    data-description-en={post.en?.data.description ?? post.vi.data.description}
                    data-has-english={String(Boolean(post.en))}
                    data-href-en={post.en ? `/blog/${post.slug}/en` : `/blog/${post.slug}`}
                >
                    <div class="overflow-hidden rounded-lg w-full max-h-[200px] sm:max-h-[350px] md:max-h-[380px] lg:w-[330px] lg:max-h-[160px] relative">
                        <Image
                            src={post.vi.data.cover}
                            alt="Post Cover"
                            class="!w-full !h-[176px] aspect-auto object-cover rounded-lg group-hover:scale-110 transition-transform duration-300"
                            priority
                        />
                        
                        <span
                            class="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-black/70 to-transparent p-2 text-white text-sm opacity-80">
                        </span>

                        {
                            !post.en && (
                                <span data-no-english class="absolute top-0 right-0 bg-[#333] text-white text-xs px-2 py-1 rounded-bl-lg opacity-80 backdrop-blur-lg">
                                    Vietnamese Only
                                </span>
                            )
                        }
                    </div>
                    <div class="flex-1 relative mt-4 lg:mt-0">
                        <h3 class="text-xl lg:text-2xl font-semibold group-hover:underline" data-post-title>
                            {post.vi.data.title}
                        </h3>
                        <p class="text-sm lg:text-base opacity-80 lg:mt-1 mt-2" data-post-description>
                            {
                                // limit description to 100 characters
                                post.vi.data.description.length > 300
                                    ? post.vi.data.description.slice(0, 300) + "..."
                                    : post.vi.data.description
                            }
                        </p>
                        <p class="text-sm opacity-80 mt-4 lg:mt-0 lg:absolute bottom-0">
                            <span class="hidden lg:inline-block">Published on{" "}</span>
                            {new Date(post.vi.data.pubDate).toLocaleDateString("en-US", {
                                year: "numeric",
                                month: "long",
                                day: "numeric",
                            })}
                        </p>
                    </div>
                </a>
            ))
        }

        {
            totalPages > 1 && (
                <nav
                    aria-label="Blog pagination"
                    class="mx-auto mt-12 pb-12 flex items-center gap-x-4"
                >
                    {
                        previousPage ? (
                            <a
                                href={getPageHref(previousPage)}
                                aria-label="Previous page"
                                class="rounded-md opacity-80 hover:opacity-100 transition-opacity cursor-pointer"
                            >
                                <Icon name="mdi:chevron-left" class="w-12 h-12 inline-block" />
                            </a>
                        ) : (
                            <span
                                aria-disabled="true"
                                class="rounded-md opacity-30 cursor-not-allowed"
                            >
                                <Icon name="mdi:chevron-left" class="w-12 h-12 inline-block" />
                            </span>
                        )
                    }

                    <span class="text-sm opacity-80">
                        Page {page.currentPage} of {totalPages}
                    </span>

                    {
                        nextPage ? (
                            <a
                                href={getPageHref(nextPage)}
                                aria-label="Next page"
                                class="rounded-md opacity-80 hover:opacity-100 transition-opacity cursor-pointer"
                            >
                                <Icon name="mdi:chevron-right" class="w-12 h-12 inline-block" />
                            </a>
                        ) : (
                            <span
                                aria-disabled="true"
                                class="rounded-md opacity-30 cursor-not-allowed"
                            >
                                <Icon name="mdi:chevron-right" class="w-12 h-12 inline-block" />
                            </span>
                        )
                    }
                </nav>
            )
        }
    </div>
</Layout>

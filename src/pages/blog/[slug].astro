---
// Vietnamese blog posts
import BlogPost from '../../components/BlogPost.astro';
import { getLocalizedPosts } from '../../utils/posts';

export async function getStaticPaths() {
    const posts = await getLocalizedPosts();

    return posts.map((post) => ({
        params: { slug: post.slug },
        props: {
            post: post.vi,
            slug: post.slug,
            alternateHref: post.en ? `/blog/${post.slug}/en` : undefined,
        },
    }));
}

const { post, slug, alternateHref } = Astro.props;
---

<BlogPost
    post={post}
    lang="vi"
    slug={slug}
    alternateHref={alternateHref}
/>
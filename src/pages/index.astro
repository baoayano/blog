---
// Importing necessary components and functions
import Layout from "../layouts/Layout.astro";
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";
import { getLocalizedPosts } from "../utils/posts";

// Type definition for blog posts
import type { LocalizedPost } from "../utils/posts";

// Fetching blog posts and sorting them by publication date
const posts = await getLocalizedPosts();
---

<Layout
	title="Home | Ari's Blog"
>
	<!-- Hero Section -->
	<section class="py-12 flex items-center gap-x-8 gap-y-8 flex-col lg:flex-row">
		<!-- New pfp (06/08/2026) -->
		<img
			src="/profile_pictures/0826.png"
			alt="Homura"
			class="w-[230px] h-[205.8px]"
			fetchpriority="high"
		/>

		<div>
			<h1 class="text-3xl lg:text-4xl font-bold mb-4 text-center lg:text-left">Welcome to Ari's Blog</h1>
			<p class="text-base lg:text-lg opacity-80 text-center lg:text-left max-w-xl lg:max-w-none">
				This is a blog about my journey learning web development,
				sharing tips, and exploring new technologies. Stay tuned for
				updates and feel free to reach out if you have any questions or
				suggestions!
			</p>

			<div class="mt-8 lg:mt-4 flex gap-x-4 justify-center lg:justify-start">
				<a
					href="https://github.com/baoayano"
					target="_blank"
					rel="noopener noreferrer"
					aria-label="Visit my GitHub profile"
					title="GitHub"
				>
					<Icon name="mdi:github" class="w-10 h-10" />
				</a>

				<a
					href="https://twitter.com/hayakawa_ayano"
					target="_blank"
					rel="noopener noreferrer"
					aria-label="Visit my Twitter profile"
					title="Twitter"
				>
					<Icon name="ri:twitter-x-line" class="w-10 h-10" />
				</a>
			</div>
		</div>
	</section>

	<!-- Recent Posts -->
	<section class="py-12">
		<h2 class="text-2xl lg:text-3xl font-semibold mb-6">Recent Posts</h2>
		<div class="grid gap-6 md:grid-cols-2">
			{
				posts.slice(0, 4).map((post: LocalizedPost) => (
					<a
						href={`/blog/${post.slug}`}
						class="blog-post block group relative"
						data-title-vi={post.vi.data.title}
						data-title-en={post.en?.data.title ?? post.vi.data.title}
						data-has-english={String(Boolean(post.en))}
						data-href-en={post.en ? `/blog/${post.slug}/en` : `/blog/${post.slug}`}
					>
						<div class="overflow-hidden rounded-lg w-full h-[230px]">
							<Image
								src={post.vi.data.cover}
								alt="Post Cover"
								class="!w-full !h-full object-cover rounded-lg group-hover:scale-110 transition-transform duration-300"
								priority
							/>
						</div>
						<div>
							<h3 class="text-xl font-semibold mt-4 group-hover:underline" data-post-title>
								{post.vi.data.title}
							</h3>
							<p class="text-sm opacity-80 mt-1" data-post-description>
								Published on{" "}
								{new Date(post.vi.data.pubDate).toLocaleDateString("en-US", {
									year: "numeric",
									month: "long",
									day: "numeric",
								})}
							</p>

							{
								// No English version badge
								!post.en && (
									<span data-no-english class="absolute top-0 right-0 bg-[#333] text-white text-xs px-2 py-1 rounded-bl-lg rounded-tr-lg opacity-80 backdrop-blur-lg">
										Vietnamese Only
									</span>
								)
							}
						</div>
					</a>
				))
			}
		</div>
</Layout>